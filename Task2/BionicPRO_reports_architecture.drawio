<mxfile host="app.diagrams.net"><diagram name="Сервис отчётов" id="d1"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="BionicPRO [Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="1300" height="960" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Покупатель протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выбор протеза, заказ, оплата&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="180" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Скачивает отчёт о работе протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="180" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Заказ протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Данные клиентов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Oracle Database]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиенты: имя, страна, модель протеза. В демо-стенде это схема crm в PostgreSQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Веб-приложение отчётов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[React, TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Кнопка Download Report, токенов не видит, только cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="220" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;BFF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[FastAPI + Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Вход через Authorization Code + PKCE, токены хранит в Redis, обновляет по refresh-токену&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="220" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Keycloak 21]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выдаёт токены, публикует ключи проверки подписи (JWKS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[DAG crm_to_olap, @daily]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;extract CRM, extract телеметрии, построение витрины, отметка обработанного дня&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Программа в чипе протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Отправка технической телеметрии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="840" width="220" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[FastAPI, backend]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /reports: проверка токена, отчёт только владельца, только обработанные дни&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="240" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Телеметрия датчиков&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="240" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;OLAP-витрина&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[ClickHouse]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;crm_customers, telemetry_daily, user_daily_report по клиентам и дням, processed_days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="540" width="240" height="150" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Оператор производства&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Работает с заказами в CRM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="600" y="-160" width="220" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;cli tool&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Инструмент ML-инженера]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выгрузка телеметрии из БД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="780" width="220" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;ML-инженер&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Улучшает модель распознавания&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1260" y="1040" width="200" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Приложение для донастройки протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[iOS, Android]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Донастройка протеза, пользуется API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="220" height="130" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="c17" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Запросы" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="c19" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="Заказ" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="Заказы" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="1. Нажимает кнопку" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="2. GET /reports, cookie" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="3. Bearer токен" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Вход, обновление токена" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.1;entryX=0.1;entryY=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="4. JWKS: проверка подписи" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="5. SELECT по username" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="A. Читает клиентов" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="B. Телеметрия за сутки" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="c14" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="C. Загрузка, JOIN в витрину, отметка дня" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="Данные с чипа" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="Телеметрия" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Как устроен отчёт&lt;/b&gt;&lt;br&gt;Светло-голубые контейнеры взяты из исходной C4 BionicPRO, тёмно-синие добавлены.&lt;br&gt;A-C. Раз в сутки Airflow загружает клиентов из CRM и суточную телеметрию в ClickHouse, объединяет их в витрину user_daily_report (по клиенту и дню) и последним шагом отмечает день обработанным.&lt;br&gt;1-5. Пользователь нажимает кнопку, браузер шлёт запрос с cookie на BFF, BFF добавляет токен из Redis и вызывает API. API берёт имя пользователя только из проверенного токена, поэтому виден отчёт одного человека. Дни, которые Airflow ещё не обработал, в отчёт не попадают.&lt;br&gt;Запрос без токена получает 401, пользователь без роли prothetic_user получает 403.&lt;br&gt;Вход пользователя и работа с внешними IdP подробно показаны на диаграмме Задания 1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1150" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>