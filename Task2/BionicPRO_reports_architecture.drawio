<mxfile host="app.diagrams.net"><diagram name="Сервис отчётов" id="d1"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="BionicPRO [Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="1300" height="960" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Покупатель протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выбор протеза, заказ, оплата&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="180" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Скачивает отчёт о работе протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="180" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Заказ протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Данные клиентов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Источник данных о клиентах]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиенты: имя, страна, модель протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Веб-приложение отчётов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[React, TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Кнопка Download Report, показывает таблицу&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="220" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Keycloak 21]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выдаёт токены, публикует ключи проверки подписи (JWKS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[DAG crm_to_olap, @daily]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;extract CRM, extract телеметрии, построение витрины, отметка обработанного дня&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Программа в чипе протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Отправка технической телеметрии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="780" width="220" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[FastAPI, backend]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /reports: проверка токена, отчёт только владельца, только обработанные дни&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="240" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Телеметрия датчиков&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="240" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;OLAP-витрина&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[ClickHouse]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;crm_customers, telemetry_daily, user_daily_report по клиентам и дням, processed_days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="540" width="240" height="150" as="geometry"/></mxCell><mxCell id="c15" value="Заказ" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Заказы" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="1. Нажимает кнопку" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="2. GET /reports, Bearer токен" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="3. JWKS: проверка подписи" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="4. SELECT по username" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="A. Читает клиентов" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="B. Телеметрия за сутки" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="C. Загрузка, JOIN в витрину, отметка дня" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="Отправка технической телеметрии" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="Телеметрия" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Как устроен отчёт&lt;/b&gt;&lt;br&gt;Светло-голубые контейнеры взяты из исходной C4 BionicPRO, тёмно-синие добавлены.&lt;br&gt;A-C. Раз в сутки Airflow загружает клиентов из CRM и суточную телеметрию в ClickHouse, объединяет их в витрину user_daily_report (по клиенту и дню) и последним шагом отмечает день обработанным.&lt;br&gt;1-4. Пользователь запрашивает отчёт. API берёт имя пользователя только из проверенного токена, поэтому виден отчёт одного человека. Дни, которые Airflow ещё не обработал, в отчёт не попадают.&lt;br&gt;Запрос без токена получает 401, пользователь без роли prothetic_user получает 403." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1500" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>