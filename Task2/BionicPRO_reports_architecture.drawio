<mxfile host="app.diagrams.net"><diagram name="Сервис отчётов" id="reports"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Контур пользователя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1020" height="360" as="geometry"/></mxCell><mxCell id="c3" value="Контур данных: ETL и OLAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="1020" height="380" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиент BionicPRO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="180" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Frontend SPA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[React, TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Кнопка Download Report, показывает таблицу отчёта&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="220" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Reports API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[FastAPI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /reports. Проверяет токен и роль, отдаёт данные только владельцу токена&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="240" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Keycloak 21]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выдаёт токены, публикует ключи проверки подписи (JWKS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="240" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL, схема crm]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиенты: имя, страна, модель протеза&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="220" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Телеметрия датчиков&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL, схема telemetry]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Сигналы протеза: движения, отклик, ошибки, заряд&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="670" width="220" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Airflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Apache Airflow 2.9]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;DAG crm_to_olap, ежедневно: extract CRM, extract телеметрии, join, load&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="240" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;OLAP-витрина&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[ClickHouse]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;user_daily_report по клиентам и дням, processed_days для обработанных периодов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="240" height="150" as="geometry"/></mxCell><mxCell id="c12" value="1. Нажимает кнопку" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="2. GET /reports, Bearer токен" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="3. JWKS: проверка подписи" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="4. SELECT по username, только обработанные дни" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="A. Читает клиентов" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="B. Агрегирует за сутки" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="C. Загрузка витрины, затем отметка дня" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Как устроен отчёт&lt;/b&gt;&lt;br&gt;A-C. Раз в сутки Airflow забирает клиентов из CRM и суточную телеметрию, объединяет их и записывает строку на клиента в витрину ClickHouse. Последним шагом день отмечается обработанным.&lt;br&gt;1-4. Пользователь запрашивает отчёт. Reports API берёт имя пользователя только из проверенного токена, поэтому видны данные одного человека. Дни, которые Airflow ещё не обработал, в отчёт не попадают.&lt;br&gt;Запрос без токена получает 401, пользователь без роли prothetic_user получает 403." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1200" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>