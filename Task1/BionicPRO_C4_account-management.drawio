<mxfile host="app.diagrams.net"><diagram name="C4: управление учётными записями" id="d1"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="BionicPRO [Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="20" width="1230" height="960" as="geometry"/></mxCell><mxCell id="c3" value="Страна представительства: внешние IdP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="330" height="560" as="geometry"/></mxCell><mxCell id="c4" value="Страна представительства: локальное хранилище" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1580" y="760" width="330" height="380" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Покупатель протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выбор протеза, заказ, оплата&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="180" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Пользуется протезом, смотрит отчёты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="180" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Вход покупателя через SSO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Bitrix24]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Вход сотрудников через SSO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Oracle Database]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиенты и заказы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="220" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Веб-приложение отчётов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[React, TypeScript, SPA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Не видит токены IdP, только cookie сессии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="220" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;BFF (auth-bff)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend for Frontend]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Authorization Code + PKCE. Хранит access и refresh токены&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Identity Broker]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Единый вход. Одна запись Identity Provider на страну&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="240" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Приложение для донастройки протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[iOS, Android]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Работает через BFF, токены IdP на устройство не попадают&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="220" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Хранилище сессий&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Токены на стороне сервера, TTL по refresh-токену&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend, resource server]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Проверяет access-токен, берёт профиль из локального хранилища&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Программа в чипе протеза&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Отправка технической телеметрии&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="220" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Техническая телеметрия, без персональных данных&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="240" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;IdP страны A&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Учётные записи офиса страны A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1610" y="230" width="270" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;IdP страны B&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML / LDAP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Учётные записи офиса страны B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1610" y="380" width="270" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;IdP страны N&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Подключается добавлением Identity Provider в Keycloak&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1610" y="530" width="270" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Profile Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Единственный доступ к локальной БД, поиск по sub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1610" y="800" width="270" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Локальная БД профилей&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL, в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Персональные и медицинские данные не покидают страну&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1610" y="980" width="270" height="120" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Оператор производства&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Работает с заказами в CRM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="-160" width="220" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;cli tool&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Инструмент ML-инженера]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Выгрузка телеметрии из БД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1220" y="760" width="220" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;ML-инженер&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Улучшает модель распознавания&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1220" y="1040" width="220" height="110" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c23" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c24" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Выбор протеза, заказ, оплата" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Заказы" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="1. Открывает веб-приложение" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="Донастройка" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="2. Login и API (cookie)" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="6. Set-Cookie SESSION" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="Запросы через BFF" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=1;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="3. Code + PKCE S256" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="5. Токены, сессия" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="7. Bearer access-токен" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="JWKS" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="SSO (OIDC)" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="SSO (OIDC)" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="4. OIDC / SAML" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="4. OIDC / SAML / LDAP" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="4. OIDC / SAML" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="8. Профиль по sub" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="9. SQL" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="Отправка технической телеметрии" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="Телеметрия" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Что изменено относительно исходной диаграммы&lt;/b&gt;&lt;br&gt;Светло-голубые контейнеры взяты из исходной C4 BionicPRO, тёмно-синие добавлены.&lt;br&gt;1. Пользователь открывает веб-приложение, SPA отправляет запрос входа на BFF.&lt;br&gt;2-3. BFF создаёт code_verifier и code_challenge (S256) и перенаправляет в Keycloak (Authorization Code + PKCE).&lt;br&gt;4. Keycloak по стране пользователя отправляет его во внешний IdP этой страны. Новая страна подключается записью Identity Provider, BFF и SPA не меняются.&lt;br&gt;5-6. BFF меняет код на токены, хранит их в Redis, SPA получает только cookie SESSION: токены IdP до фронтенда не доходят.&lt;br&gt;7-9. BFF вызывает API с access-токеном, API берёт персональные и медицинские данные из локальной БД своей страны через Profile Service.&lt;br&gt;Интернет-магазин и CRM входят через Keycloak по OIDC, так достигается единый доступ ко всем системам BionicPRO." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1130" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>