<mxfile host="app.diagrams.net"><diagram name="C4 управление учётными записями" id="c4acc"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="BionicPRO: платформа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1020" height="780" as="geometry"/></mxCell><mxCell id="c3" value="Страна представительства: локальное хранилище (PII и медицинские данные не покидают страну)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380" y="180" width="360" height="440" as="geometry"/></mxCell><mxCell id="c4" value="Страна представительства: внешние IdP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380" y="660" width="360" height="480" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Клиент или сотрудник BionicPRO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="180" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Frontend SPA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[React, TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Не хранит токены. Только cookie сессии httpOnly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="220" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;BFF (auth-bff)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend for Frontend]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Authorization Code + PKCE. Хранит access и refresh токены, SPA получает только cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="240" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Reports API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend, resource server]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Проверяет access-токен (подпись, срок, aud), отдаёт данные только владельцу&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="240" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Хранилище сессий&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Токены на стороне сервера, TTL по сроку refresh-токена&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="240" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Keycloak (Identity Broker)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Keycloak 21]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Единая точка входа. Одна запись Identity Provider на страну&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="240" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;БД Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Только идентификаторы и привязки к внешним IdP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="540" width="220" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Profile Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Backend в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Единственный доступ к локальной БД, ищет профиль по sub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1410" y="240" width="300" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Локальная БД профилей&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[PostgreSQL, в стране]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Персональные и медицинские данные. Ключ связи: sub из токена IdP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1410" y="440" width="300" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;IdP страны A&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Учётные записи офиса страны A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1410" y="710" width="300" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;IdP страны B&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML / LDAP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Учётные записи офиса страны B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1410" y="840" width="300" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;IdP страны N&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[OIDC / SAML]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Подключается добавлением Identity Provider в Keycloak, без изменения BFF и SPA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=#FFFFFF;fontColor=#FFFFFF;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1410" y="970" width="300" height="130" as="geometry"/></mxCell><mxCell id="c17" value="1. Открывает приложение" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="2. Login, API (cookie)" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="6. Set-Cookie SESSION" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="3. Code + PKCE S256" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="5. Токены, сессия" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="8. Bearer access-токен" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="JWKS" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="9. Профиль по sub" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="10. SQL" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="Привязки IdP" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="4. OIDC / SAML" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="4. OIDC / SAML / LDAP" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="4. OIDC / SAML" style="endArrow=classic;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Как работает вход&lt;/b&gt;&lt;br&gt;1. Пользователь открывает SPA.&lt;br&gt;2. SPA отправляет на BFF запрос входа, BFF создаёт code_verifier и code_challenge (S256).&lt;br&gt;3. BFF перенаправляет в Keycloak (Authorization Code + PKCE).&lt;br&gt;4. Keycloak по стране пользователя отправляет его в свой внешний IdP.&lt;br&gt;5. BFF меняет код на токены и хранит их в Redis.&lt;br&gt;6. SPA получает только cookie SESSION, токены до браузера не доходят.&lt;br&gt;7. Запросы SPA идут на BFF с cookie.&lt;br&gt;8. BFF вызывает Reports API с access-токеном.&lt;br&gt;9-10. API по sub берёт данные из локальной БД своей страны." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1200" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>